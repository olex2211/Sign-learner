{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://awhile-obtrusive-decree.ngrok-free.dev",
        "EXPO_PUBLIC_ML_MODE": "auto"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://awhile-obtrusive-decree.ngrok-free.dev",
        "EXPO_PUBLIC_ML_MODE": "auto"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://awhile-obtrusive-decree.ngrok-free.dev",
        "EXPO_PUBLIC_ML_MODE": "auto"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
