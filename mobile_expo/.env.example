# Sign-Learner Expo Mobile App
# Copy this file to .env and fill in your values

# API URL for Android emulator (default)
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Gesture prediction mode:
# auto = native on-device ML with backend fallback
# local = native on-device ML only
# server = backend /api/ml/predict only
EXPO_PUBLIC_ML_MODE=auto

# For physical Android device on the same Wi-Fi, use your laptop's LAN IP:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000

# For iOS simulator or web:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
